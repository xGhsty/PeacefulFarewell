<Defs>

  <ThoughtDef>
    <defName>PF_RequestToLeaveDenied</defName>
    <thoughtClass>PeacefulFarewell.Thought_MemoryWithOwnerGender</thoughtClass>
    <durationDays>4</durationDays>
    <stages>
      <li>
        <label>forbidden to leave</label>
        <description>I wanted to leave with someone close to me, but I was not allowed to. It still stings.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>PF_LonelinessDenied</defName>
    <thoughtClass>PeacefulFarewell.Thought_MemoryWithOwnerGender</thoughtClass>
