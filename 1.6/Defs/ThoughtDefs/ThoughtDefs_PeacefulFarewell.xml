  <ThoughtDef>
    <defName>PF_LonelinessExcitedToLeave</defName>
    <thoughtClass>PeacefulFarewell.Thought_MemoryWithOwnerGender</thoughtClass>
    <durationDays>2</durationDays>
    <stages>
      <li>
