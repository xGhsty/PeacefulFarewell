    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a weight lifted</label>
        <description>I hadn't realized how much I was worrying about {0} until the word came that they were alright. I finally slept easy last night.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Granted whenever a settled pawn (living with a friendly faction after
       leaving the colony) writes a letter back - see
       FarewellUtility.TrySendLetterFromAfar. One shared thought regardless of
       closeness tier, since only one recipient is ever picked per letter
       (unlike HeardTheyreSafe/WordNeverCame, which notify everyone eligible
       at once for a single one-time event). -->
  <ThoughtDef>
    <defName>PF_LetterFromAfar</defName>
    <thoughtClass>PeacefulFarewell.Thought_MemoryWithSubject</thoughtClass>
    <durationDays>1</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a letter arrived</label>
        <description>{0} sent word from wherever they've settled. It's good to hear from them.</description>
        <baseMoodEffect>3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- Visit talks (PF_VisitMeeting). GoodToSeeVisitor: the colonist talked
       with a visiting relation/friend and decided to stay (or the visitors
       left before the last talk). SnubbedByVisitor: the visitor's recipient
       thought from PF_VisitTalk_Snub - a social thought, so it also lowers
       the colonist's opinion of the visitor, which in turn weighs into the
       decision (FarewellUtility.ComputeVisitPull). -->
  <ThoughtDef>
    <defName>PF_GoodToSeeVisitor</defName>
    <thoughtClass>PeacefulFarewell.Thought_MemoryWithSubject</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>good to see {0} again</label>
        <description>{0} came with the visitors and we finally got to talk. My place is here, but it was good to see them again.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>PF_SnubbedByVisitor</defName>
    <thoughtClass>PeacefulFarewell.Thought_MemorySocialWithGender</thoughtClass>
    <durationDays>10</durationDays>
    <stackLimit>10</stackLimit>
    <stackLimitForSameOtherPawn>3</stackLimitForSameOtherPawn>
    <stackedEffectMultiplier>0.8</stackedEffectMultiplier>
    <stages>
      <li>
        <label>snubbed during the visit</label>
        <description>{0} barely had time for me during the visit. I thought we meant more to each other than that.</description>
        <baseMoodEffect>-3</baseMoodEffect>
        <baseOpinionOffset>-12</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
