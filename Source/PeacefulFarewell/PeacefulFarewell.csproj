<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>PeacefulFarewell</RootNamespace>
    <AssemblyName>PeacefulFarewell</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Game version to build for. 1.7 (default) compiles against the
         local RimWorld install; 1.6 compiles against the Krafs.Rimworld.Ref
         reference package, since the local install is already on 1.7:
           dotnet build -p:GameVersion=1.6 -->
    <GameVersion Condition="'$(GameVersion)' == ''">1.7</GameVersion>
    <OutputPath>bin\$(GameVersion)\</OutputPath>
    <IntermediateOutputPath>obj\$(GameVersion)\</IntermediateOutputPath>

    <!-- Path to the RimWorld install folder. Override with
         -p:RimWorldPath="..." on the command line if it differs
         from the default below. -->
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">H:\SteamLibrary\steamapps\common\RimWorld</RimWorldPath>

    <!-- Where the built mod is copied to after each build. -->
    <ModDeployPath>$(RimWorldPath)\Mods\PeacefulFarewell</ModDeployPath>
  </PropertyGroup>

  <!-- 1.7 runs on .NET with Assembly-CSharp in the install root, and
       redirects every UnityEngine.* reference to UnityStubs. -->
  <ItemGroup Condition="'$(GameVersion)' == '1.7'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(GameVersion)' == '1.6'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.3.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Copy the built assembly into the mod's per-version Assemblies folder,
       then mirror the whole mod folder into the local RimWorld Mods
       directory so it can be tested immediately. -->
  <Target Name="CopyToModAssemblies" AfterTargets="Build">
    <ItemGroup>
      <ModAssemblies Include="$(TargetDir)PeacefulFarewell.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ModAssemblies)" DestinationFolder="$(ProjectDir)..\..\$(GameVersion)\Assemblies" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="DeployToRimWorldMods" AfterTargets="CopyToModAssemblies" Condition="Exists('$(RimWorldPath)\Mods')">
    <ItemGroup>
      <!-- The git repository lives in the mod root, so keep .git and
           repo-only files out of the game's Mods folder. -->
      <ModFiles Include="$(ProjectDir)..\..\**\*" Exclude="$(ProjectDir)..\..\Source\**\*;$(ProjectDir)..\..\.git\**\*;$(ProjectDir)..\..\.gitignore;$(ProjectDir)..\..\README.md" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDeployPath)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
